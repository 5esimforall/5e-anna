// Single-use preflight and finite follow-up observations. No mutable external state.
// Library exceptions are positive knowledge facts; absence means unsupported within
// these explicitly pinned profiles, never permission borrowed from another edition.

// @rule cast.spell
CastSpell(E,R,I) :- CastRequest(E,R,_,P,G,B,_), GrantedArmorSpell(E,P,G,B,I), ArmorProcedure(E,I,"automatic"), SpellRequirements(E,I,"action","touch"), ArmorSpellProfile(E,I,_,_).

// @rule cast.material.waived
CastMaterialPolicy(E,R,1) :- CastSpell(E,R,_), CastRequest(E,R,_,P,G,B,_), WaivedCastingComponent(E,P,G,B,"M").

// @rule cast.material.required
CastMaterialPolicy(E,R,0) :- CastSpell(E,R,_), CastRequest(E,R,_,P,G,B,_), !WaivedCastingComponent(E,P,G,B,"M").

// @rule cast.dismiss.permitted
CastDismissalPolicy(E,R,1) :- CastSpell(E,R,I), SpellDismissalAction(E,I,"action").

// @rule cast.dismiss.unsupported
CastDismissalPolicy(E,R,0) :- CastSpell(E,R,I), !SpellDismissalAction(E,I,"action").

// @rule cast.selection
CastSelection(E,R,I,W,D) :- CastSpell(E,R,I), CastMaterialPolicy(E,R,W), CastDismissalPolicy(E,R,D).

// @rule cast.block.feature
CastBlocked(E,R,"missing_feature") :- CastRequest(E,R,A,P,_,_,_), !FeatureAccess(E,A,P).

// @rule cast.block.target
CastBlocked(E,R,"self_only") :- CastRequest(E,R,A,_,_,_,T), A != T.

// @rule cast.block.willing
CastBlocked(E,R,"unwilling_target") :- CastReadiness(E,R,_,_,_,0,_,_).

// @rule cast.block.armor
CastBlocked(E,R,"armored_target") :- CastReadiness(E,R,_,_,_,_,1,_).

// @rule cast.block.action
CastBlocked(E,R,"no_action") :- CastResources(E,R,0,_).

// @rule cast.block.verbal
CastBlocked(E,R,"verbal_unavailable") :- CastReadiness(E,R,0,_,_,_,_,_).

// @rule cast.block.somatic
CastBlocked(E,R,"somatic_unavailable") :- CastReadiness(E,R,_,0,_,_,_,_).

// @rule cast.block.material
CastBlocked(E,R,"material_unavailable") :- CastSelection(E,R,_,0,_), CastReadiness(E,R,_,_,0,_,_,_).

// @rule cast.allowed
CastAllowed(E,R) :- CastSelection(E,R,_,_,_), CastResources(E,R,_,_), CastReadiness(E,R,_,_,_,_,_,_), !CastBlocked(E,R,_).

// @rule cast.state.accept
CastState(E,R,0,A-1,S,1) :- CastAllowed(E,R), CastResources(E,R,A,S).

// @rule cast.state.reject
CastState(E,R,0,A,S,0) :- CastSelection(E,R,_,_,_), CastBlocked(E,R,_), CastResources(E,R,A,S), CastReadiness(E,R,_,_,_,_,_,_).

// @rule cast.cost.initial
CastCost(E,R,0,A-B,S-T) :- CastResources(E,R,A,S), CastState(E,R,0,B,T,_).

// @rule cast.clock.initial
CastClock(E,R,0,0,0) :- CastRequest(E,R,_,_,_,_,_).

// @rule cast.clock.followup
CastClock(E,R,N,T,U) :- CastFollowup(E,R,N,T,U,_,_,_).

// @rule cast.worn.initial
CastWorn(E,R,0,W) :- CastReadiness(E,R,_,_,_,_,W,_).

// @rule cast.worn.followup
CastWorn(E,R,N,W) :- CastFollowup(E,R,N,_,_,_,W,_).

// @rule cast.cursor.same
CastCursor(E,R,N,A,S,F) :- CastFollowup(E,R,N,_,U,_,_,_), CastClock(E,R,N-1,_,U), CastState(E,R,N-1,A,S,F).

// @rule cast.cursor.new
CastCursor(E,R,N,1,S,F) :- CastFollowup(E,R,N,_,U,_,_,_), CastClock(E,R,N-1,_,V), U > V, CastState(E,R,N-1,_,S,F).

// @rule cast.before.inactive
CastBefore(E,R,N,A,S,0) :- CastCursor(E,R,N,A,S,0).

// @rule cast.before.expired
CastBefore(E,R,N,A,S,0) :- CastCursor(E,R,N,A,S,1), CastClock(E,R,N,T,_), CastSelection(E,R,I,_,_), ArmorSpellProfile(E,I,_,H), T >= H*3600.

// @rule cast.before.armored
CastBefore(E,R,N,A,S,0) :- CastCursor(E,R,N,A,S,1), CastWorn(E,R,N,1).

// @rule cast.before.active
CastBefore(E,R,N,A,S,1) :- CastCursor(E,R,N,A,S,1), CastClock(E,R,N,T,_), CastSelection(E,R,I,_,_), ArmorSpellProfile(E,I,_,H), T < H*3600, CastWorn(E,R,N,0).

// @rule cast.end.expired
CastEnded(E,R,N,"duration") :- CastCursor(E,R,N,_,_,1), CastClock(E,R,N,T,_), CastSelection(E,R,I,_,_), ArmorSpellProfile(E,I,_,H), T >= H*3600.

// @rule cast.end.armored
CastEnded(E,R,N,"armor") :- CastCursor(E,R,N,_,_,1), CastWorn(E,R,N,1).

// @rule cast.event.observe
CastStepResult(E,R,N,"observed",A,S,F) :- CastFollowup(E,R,N,_,_,"observe",_,_), CastBefore(E,R,N,A,S,F).

// @rule cast.event.spend
CastStepResult(E,R,N,"action_spent",0,S,F) :- CastFollowup(E,R,N,_,_,"spend_action",_,1), CastBefore(E,R,N,1,S,F).

// @rule cast.event.spend.denied
CastStepResult(E,R,N,"no_action",0,S,F) :- CastFollowup(E,R,N,_,_,"spend_action",_,1), CastBefore(E,R,N,0,S,F).

// @rule cast.event.dismiss.unsupported
CastStepResult(E,R,N,"unsupported_dismissal",A,S,F) :- CastFollowup(E,R,N,_,_,"dismiss",_,_), CastSelection(E,R,_,_,0), CastBefore(E,R,N,A,S,F).

// @rule cast.event.dismiss.inactive
CastStepResult(E,R,N,"no_active_effect",A,S,0) :- CastFollowup(E,R,N,_,_,"dismiss",_,_), CastSelection(E,R,_,_,1), CastBefore(E,R,N,A,S,0).

// @rule cast.event.dismiss.noaction
CastStepResult(E,R,N,"no_action",0,S,1) :- CastFollowup(E,R,N,_,_,"dismiss",_,1), CastSelection(E,R,_,_,1), CastBefore(E,R,N,0,S,1).

// @rule cast.event.dismiss
CastStepResult(E,R,N,"dismissed",0,S,0) :- CastFollowup(E,R,N,_,_,"dismiss",_,1), CastSelection(E,R,_,_,1), CastBefore(E,R,N,1,S,1).

// @rule cast.end.dismissed
CastEnded(E,R,N,"dismissed") :- CastStepResult(E,R,N,"dismissed",_,_,_).

// @rule cast.state.followup
CastState(E,R,N,A,S,F) :- CastStepResult(E,R,N,_,A,S,F).

// @rule cast.cost.followup
CastCost(E,R,N,A-B,S-T) :- CastBefore(E,R,N,A,S,_), CastState(E,R,N,B,T,_).

// @rule mage.armor.value
ArmorSpellValue(E,A,I,B+M) :- ArmorSpellProfile(E,I,B,_), AbilityModifier(E,A,"dex",M).

// @rule cast.ac.active
CastBaseAC(E,R,N,AC) :- CastState(E,R,N,_,_,1), CastRequest(E,R,A,_,_,_,_), CastSelection(E,R,I,_,_), ArmorSpellValue(E,A,I,AC).

// @rule cast.ac.unarmored
CastBaseAC(E,R,N,AC) :- CastState(E,R,N,_,_,0), CastWorn(E,R,N,0), CastRequest(E,R,A,_,_,_,_), UnarmoredAC(E,A,AC).

// @rule validate.cast.selection
Violation(E,R,"unsupported_cast_branch") :- CastRequest(E,R,_,_,_,_,_), !CastSelection(E,R,_,_,_).

// @rule validate.cast.resources
Violation(E,R,"missing_cast_resources") :- CastRequest(E,R,_,_,_,_,_), !CastResources(E,R,_,_).

// @rule validate.cast.readiness
Violation(E,R,"missing_cast_readiness") :- CastRequest(E,R,_,_,_,_,_), !CastReadiness(E,R,_,_,_,_,_,_).

// @rule validate.cast.dex
Violation(E,R,"missing_cast_ability") :- CastRequest(E,R,A,_,_,_,_), !AbilityScore(E,A,"dex",_).

// @rule validate.cast.orphan.resources
Violation(E,R,"orphan_cast_resources") :- CastResources(E,R,_,_), !CastRequest(E,R,_,_,_,_,_).

// @rule validate.cast.orphan.readiness
Violation(E,R,"orphan_cast_readiness") :- CastReadiness(E,R,_,_,_,_,_,_), !CastRequest(E,R,_,_,_,_,_).

// @rule validate.cast.orphan.followup
Violation(E,R,"orphan_cast_followup") :- CastFollowup(E,R,_,_,_,_,_,_), !CastRequest(E,R,_,_,_,_,_).

// @rule validate.cast.gap
Violation(E,R,"missing_cast_step") :- CastFollowup(E,R,N,_,_,_,_,_), !CastClock(E,R,N-1,_,_).

// @rule validate.cast.time
Violation(E,R,"cast_time_reversed") :- CastFollowup(E,R,N,T,_,_,_,_), CastClock(E,R,N-1,P,_), T < P.

// @rule validate.cast.turn
Violation(E,R,"cast_turn_reversed") :- CastFollowup(E,R,N,_,T,_,_,_), CastClock(E,R,N-1,_,P), T < P.

// @rule validate.cast.overlap
Violation(E,A,"multiple_cast_runs") :- CastRequest(E,R,A,_,_,_,_), CastRequest(E,S,A,_,_,_,_), R != S.

// @rule validate.cast.snapshot
Violation(E,R,"mixed_cast_snapshot") :- CastRequest(E,R,A,_,_,_,_), ArmorSpell(E,_,_,A,_,_).

// @rule validate.cast.loadout
Violation(E,R,"mixed_cast_loadout") :- CastRequest(E,R,A,_,_,_,_), ArmorLoadout(E,A,_,_,_,_).

// @rule validate.cast.unsupported.feature
Violation(E,A,"unsupported_feature_access") :- FeatureAccess(E,A,P), !GrantedArmorSpell(E,P,_,_,_).

// @rule validate.cast.unique.state.actions
Violation(E,R,"conflicting_cast_state") :- CastState(E,R,N,A,S,F), CastState(E,R,N,B,T,G), A != B.

// @rule validate.cast.unique.state.slots
Violation(E,R,"conflicting_cast_state") :- CastState(E,R,N,A,S,F), CastState(E,R,N,B,T,G), S != T.

// @rule validate.cast.unique.state.effect
Violation(E,R,"conflicting_cast_state") :- CastState(E,R,N,A,S,F), CastState(E,R,N,B,T,G), F != G.

// @rule validate.cast.complete
Violation(E,R,"incomplete_cast_step") :- CastFollowup(E,R,N,_,_,_,_,_), !CastState(E,R,N,_,_,_).

// @rule cast.block.permission
CastBlocked(E,R,"cannot_act") :- CastReadiness(E,R,_,_,_,_,_,0).

// @rule cast.event.spend.unavailable
CastStepResult(E,R,N,"cannot_act",A,S,F) :- CastFollowup(E,R,N,_,_,"spend_action",_,0), CastBefore(E,R,N,A,S,F).

// @rule cast.event.dismiss.unavailable
CastStepResult(E,R,N,"cannot_act",A,S,1) :- CastFollowup(E,R,N,_,_,"dismiss",_,0), CastSelection(E,R,_,_,1), CastBefore(E,R,N,A,S,1).
