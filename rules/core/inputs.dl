// @rule input.test
Test(E,T,A,K,B,N,C,P) :- TestInput(E,T,A,K,B,N,C,P).

// @rule input.attack
Attack(E,T,A,D,M,N,X) :- AttackInput(E,T,A,D,M,N,X).

// @rule input.damagedice
DamageDice(E,T,C,N,S) :- DamageDiceInput(E,T,C,N,S).

// @rule input.legacy.penalty
TestPenalty(E,T,0) :- Test(E,T,_,_,_,_,_,_).

// @rule validate.legacy.rank
Violation(E,A,"unsupported_rank") :- Rank(E,A,R), R > 20.

// @rule skill.ability.default
CheckAbility(E,T,B) :- SkillCheck(E,T,_,S,_,_), SkillAbility(E,S,B), !SkillAbilityOverride(E,T,_).

// @rule skill.ability.override
CheckAbility(E,T,B) :- SkillCheck(E,T,_,_,_,_), SkillAbilityOverride(E,T,B).

// @rule skill.training.known
SkillTraining(E,T,P) :- SkillCheck(E,T,A,S,_,_), SkillProficiency(E,A,S,P).

// @rule skill.training.none
SkillTraining(E,T,"none") :- SkillCheck(E,T,A,S,_,_), !SkillProficiency(E,A,S,_).

// @rule tool.trained
TrainedTool(E,T) :- SkillCheck(E,T,A,_,_,_), ToolUse(E,T,I), ToolProficiency(E,A,I).

// @rule skill.training.alone
CheckTraining(E,T,P) :- SkillTraining(E,T,P), !TrainedTool(E,T).

// @rule skill.training.tool.proficient
CheckTraining(E,T,"proficient") :- SkillTraining(E,T,"proficient"), TrainedTool(E,T).

// @rule skill.training.tool.expertise
CheckTraining(E,T,"expertise") :- SkillTraining(E,T,"expertise"), TrainedTool(E,T).

// @rule skill.training.tool.replace.none
CheckTraining(E,T,"proficient") :- SkillTraining(E,T,"none"), TrainedTool(E,T).

// @rule skill.training.tool.replace.half
CheckTraining(E,T,"proficient") :- SkillTraining(E,T,"half"), TrainedTool(E,T).

// @rule skill.tool.advantage
HasAdvantage(E,T) :- TrainedTool(E,T), SkillTraining(E,T,P), P = "proficient".

// @rule skill.tool.expertise.advantage
HasAdvantage(E,T) :- TrainedTool(E,T), SkillTraining(E,T,"expertise").

// @rule skill.test
Test(E,T,A,"check",B,DC,C,P) :- SkillCheck(E,T,A,_,DC,C), CheckAbility(E,T,B), CheckTraining(E,T,P).

// @rule tool.test.trained
Test(E,T,A,"check",B,DC,C,"proficient") :- ToolCheck(E,T,A,I,B,DC,C), ToolProficiency(E,A,I).

// @rule tool.test.untrained
Test(E,T,A,"check",B,DC,C,"none") :- ToolCheck(E,T,A,I,B,DC,C), !ToolProficiency(E,A,I).

// @rule weapon.ability.melee
WeaponAbility(E,T,"str") :- WeaponUse(E,T,_,W,_,_,"default",_,_), WeaponProfile(E,W,"melee",_,_,0,_,_,_,_).

// @rule weapon.ability.ranged
WeaponAbility(E,T,"dex") :- WeaponUse(E,T,_,W,_,_,"default",_,_), WeaponProfile(E,W,"ranged",_,_,0,_,_,_,_).

// @rule weapon.ability.finesse.str
WeaponAbility(E,T,"str") :- WeaponUse(E,T,_,W,_,_,"str",_,_), WeaponProfile(E,W,_,_,_,1,_,_,_,_).

// @rule weapon.ability.finesse.dex
WeaponAbility(E,T,"dex") :- WeaponUse(E,T,_,W,_,_,"dex",_,_), WeaponProfile(E,W,_,_,_,1,_,_,_,_).

// @rule weapon.training.yes
WeaponTraining(E,T,"proficient") :- WeaponUse(E,T,A,W,_,_,_,_,_), WeaponProficiency(E,A,W).

// @rule weapon.training.no
WeaponTraining(E,T,"none") :- WeaponUse(E,T,A,W,_,_,_,_,_), !WeaponProficiency(E,A,W).

// @rule weapon.test
Test(E,T,A,"attack",B,AC,C,P) :- WeaponUse(E,T,A,_,D,_,_,_,C), WeaponAbility(E,T,B), ArmorClass(E,D,AC), WeaponTraining(E,T,P).

// @rule weapon.context.melee
Attack(E,T,D,N,"melee",5,5) :- WeaponUse(E,T,_,W,D,"melee",_,N,_), WeaponProfile(E,W,"melee",_,_,_,_,_,_,_).

// @rule weapon.context.ranged
Attack(E,T,D,N,"ranged",R,M) :- WeaponUse(E,T,_,W,D,"ranged",_,N,_), WeaponProfile(E,W,"ranged",R,M,_,_,_,_,_).

// @rule weapon.context.thrown
Attack(E,T,D,N,"ranged",R,M) :- WeaponUse(E,T,_,W,D,"thrown",_,N,_), WeaponProfile(E,W,_,R,M,_,1,_,_,_).

// @rule weapon.damage.modifier
WeaponDamageModifier(E,T,M) :- WeaponUse(E,T,A,_,_,_,_,_,_), WeaponAbility(E,T,B), AbilityModifier(E,A,B,M).

// @rule weapon.damage.dice
DamageDice(E,T,"weapon",N,S) :- WeaponUse(E,T,_,W,_,_,_,_,_), WeaponProfile(E,W,_,_,_,_,_,_,N,S).

// @rule weapon.not.ready
BlockedAttack(E,T,"weapon_not_ready") :- WeaponUse(E,T,_,_,_,_,_,_,_), WeaponReady(E,T,0).

// @rule weapon.heavy.size.tiny
HasDisadvantage(E,T) :- WeaponUse(E,T,A,W,_,_,_,_,_), WeaponProfile(E,W,_,_,_,_,_,1,_,_), ActorSize(E,A,"tiny").

// @rule weapon.heavy.size.small
HasDisadvantage(E,T) :- WeaponUse(E,T,A,W,_,_,_,_,_), WeaponProfile(E,W,_,_,_,_,_,1,_,_), ActorSize(E,A,"small").

// @rule weapon.heavy.ability.melee
HasDisadvantage(E,T) :- WeaponUse(E,T,A,W,_,_,_,_,_), WeaponProfile(E,W,"melee",_,_,_,_,1,_,_), AbilityScore(E,A,"str",S), S < 13.

// @rule weapon.heavy.ability.ranged
HasDisadvantage(E,T) :- WeaponUse(E,T,A,W,_,_,_,_,_), WeaponProfile(E,W,"ranged",_,_,_,_,1,_,_), AbilityScore(E,A,"dex",S), S < 13.

// @rule armor.base.unarmored
ArmorBase(E,A,N) :- ArmorLoadout(E,A,"unarmored",_,_,_), UnarmoredAC(E,A,N), !ArmorSpellActive(E,_,A,_).

// @rule armor.base.light
ArmorBase(E,A,B+M) :- ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,"light",B,_,_), AbilityModifier(E,A,"dex",M).

// @rule armor.base.medium
ArmorBase(E,A,B+min(M,2)) :- ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,"medium",B,_,_), AbilityModifier(E,A,"dex",M).

// @rule armor.base.heavy
ArmorBase(E,A,B) :- ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,"heavy",B,_,_).

// @rule armor.shield.none
ShieldBonus(E,A,0) :- ArmorLoadout(E,A,_,_,0,_).

// @rule armor.shield.trained
ShieldBonus(E,A,2) :- ArmorLoadout(E,A,_,_,1,1).

// @rule armor.shield.untrained
ShieldBonus(E,A,0) :- ArmorLoadout(E,A,_,_,1,0).

// @rule armor.total
ArmorClass(E,A,B+S) :- ArmorBase(E,A,B), ShieldBonus(E,A,S).

// @rule armor.strength.penalty
ArmorSpeedPenalty(E,A,10) :- ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,_,_,R,_), AbilityScore(E,A,"str",S), S < R.

// @rule armor.strength.sufficient
ArmorSpeedPenalty(E,A,0) :- ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,_,_,R,_), AbilityScore(E,A,"str",S), S >= R.

// @rule armor.stealth
HasDisadvantage(E,T) :- SkillCheck(E,T,A,"stealth",_,_), CheckAbility(E,T,"dex"), ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,_,_,_,1).

// @rule armor.untrained.str
HasDisadvantage(E,T) :- Test(E,T,A,_,"str",_,_,_), ArmorLoadout(E,A,I,0,_,_), ArmorProfile(E,I,_,_,_,_).

// @rule armor.untrained.dex
HasDisadvantage(E,T) :- Test(E,T,A,_,"dex",_,_,_), ArmorLoadout(E,A,I,0,_,_), ArmorProfile(E,I,_,_,_,_).

// @rule armor.casting.blocked
CannotCast(E,A) :- ArmorLoadout(E,A,I,0,_,_), ArmorProfile(E,I,_,_,_,_).

// @rule casting.dc
SpellSaveDC(E,A,I,8+M+P) :- CastingSource(E,A,I), CastingAbility(E,I,B), AbilityModifier(E,A,B,M), ProficiencyBonus(E,A,P).

// @rule casting.attack
SpellAttackBonus(E,A,I,M+P) :- CastingSource(E,A,I), CastingAbility(E,I,B), AbilityModifier(E,A,B,M), ProficiencyBonus(E,A,P).

// @rule save.training.yes
SaveTraining(E,T,"proficient") :- SpellSave(E,T,A,_,_,B,_), SaveProficiency(E,A,B).

// @rule save.training.no
SaveTraining(E,T,"none") :- SpellSave(E,T,A,_,_,B,_), !SaveProficiency(E,A,B).

// @rule save.test
Test(E,T,A,"save",B,DC,C,P) :- SpellSave(E,T,A,S,I,B,C), SpellSaveDC(E,S,I,DC), SaveTraining(E,T,P).

// @rule mage.armor.active
ArmorSpellActive(E,F,A,B) :- ArmorSpell(E,F,I,A,H,0), ArmorSpellProfile(E,I,B,L), H < L, ArmorLoadout(E,A,"unarmored",_,_,_).

// @rule mage.armor.base
ArmorBase(E,A,B+M) :- ArmorSpellActive(E,_,A,B), AbilityModifier(E,A,"dex",M).

// @rule mage.armor.expired
ArmorSpellEnded(E,F,"duration") :- ArmorSpell(E,F,I,_,H,_), ArmorSpellProfile(E,I,_,L), H >= L.

// @rule mage.armor.armored
ArmorSpellEnded(E,F,"armor") :- ArmorSpell(E,F,I,A,_,_), ArmorSpellProfile(E,I,_,_), ArmorLoadout(E,A,W,_,_,_), W != "unarmored".

// @rule mage.armor.dismissed
ArmorSpellEnded(E,F,"dismissed") :- ArmorSpell(E,F,_,_,_,1).

// @rule request.explicit
TestRequest(E,T,"explicit") :- TestInput(E,T,_,_,_,_,_,_).

// @rule request.skill
TestRequest(E,T,"skill") :- SkillCheck(E,T,_,_,_,_).

// @rule request.tool
TestRequest(E,T,"tool") :- ToolCheck(E,T,_,_,_,_,_).

// @rule request.weapon
TestRequest(E,T,"weapon") :- WeaponUse(E,T,_,_,_,_,_,_,_).

// @rule request.spell_save
TestRequest(E,T,"spell_save") :- SpellSave(E,T,_,_,_,_,_).

// @rule validate.input.request.conflict
Violation(E,T,"conflicting_test_request") :- TestRequest(E,T,K), TestRequest(E,T,L), K != L.

// @rule validate.input.request.unresolved
Violation(E,T,"unresolved_test_request") :- TestRequest(E,T,_), !Test(E,T,_,_,_,_,_,_).

// @rule validate.input.skill.unknown
Violation(E,T,"unsupported_skill") :- SkillCheck(E,T,_,S,_,_), !SkillAbility(E,S,_).

// @rule validate.input.skill.override
Violation(E,T,"orphan_skill_override") :- SkillAbilityOverride(E,T,_), !SkillCheck(E,T,_,_,_,_).

// @rule validate.input.skill.tool
Violation(E,T,"orphan_tool_use") :- ToolUse(E,T,_), !SkillCheck(E,T,_,_,_,_).

// @rule validate.input.weapon.unknown
Violation(E,T,"unsupported_weapon") :- WeaponUse(E,T,_,W,_,_,_,_,_), !WeaponProfile(E,W,_,_,_,_,_,_,_,_).

// @rule validate.input.weapon.choice
Violation(E,T,"missing_or_invalid_weapon_ability") :- WeaponUse(E,T,_,_,_,_,_,_,_), !WeaponAbility(E,T,_).

// @rule validate.input.weapon.mode
Violation(E,T,"unsupported_weapon_mode") :- WeaponUse(E,T,_,_,_,_,_,_,_), !Attack(E,T,_,_,_,_,_).

// @rule validate.input.weapon.ac
Violation(E,T,"missing_target_ac") :- WeaponUse(E,T,_,_,A,_,_,_,_), !ArmorClass(E,A,_).

// @rule validate.input.weapon.ready
Violation(E,T,"missing_weapon_readiness") :- WeaponUse(E,T,_,_,_,_,_,_,_), !WeaponReady(E,T,_).

// @rule validate.input.weapon.ready.orphan
Violation(E,T,"orphan_weapon_readiness") :- WeaponReady(E,T,_), !WeaponUse(E,T,_,_,_,_,_,_,_).

// @rule validate.input.weapon.explicit.context
Violation(E,T,"conflicting_attack_context") :- WeaponUse(E,T,_,_,_,_,_,_,_), AttackInput(E,T,_,_,_,_,_).

// @rule validate.input.weapon.explicit.dice
Violation(E,T,"conflicting_weapon_dice") :- WeaponUse(E,T,_,_,_,_,_,_,_), DamageDiceInput(E,T,"weapon",_,_).

// @rule validate.input.armor.unknown
Violation(E,A,"unsupported_armor") :- ArmorLoadout(E,A,I,_,_,_), I != "unarmored", !ArmorProfile(E,I,_,_,_,_).

// @rule validate.input.armor.dex
Violation(E,A,"missing_armor_ability") :- ArmorLoadout(E,A,"unarmored",_,_,_), !AbilityScore(E,A,"dex",_).

// @rule validate.input.armor.strength
Violation(E,A,"missing_armor_strength") :- ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,_,_,R,_), R > 0, !AbilityScore(E,A,"str",_).

// @rule validate.input.casting.unknown
Violation(E,A,"unsupported_casting_source") :- CastingSource(E,A,I), !CastingAbility(E,I,_).

// @rule validate.input.casting.ability
Violation(E,A,"missing_casting_ability") :- CastingSource(E,A,I), CastingAbility(E,I,B), !AbilityScore(E,A,B,_).

// @rule validate.input.casting.rank
Violation(E,A,"missing_casting_rank") :- CastingSource(E,A,_), !Rank(E,A,_).

// @rule validate.input.save.source
Violation(E,T,"missing_casting_source") :- SpellSave(E,T,_,A,I,_,_), !CastingSource(E,A,I).

// @rule validate.input.spell.unknown
Violation(E,F,"unsupported_armor_spell") :- ArmorSpell(E,F,I,_,_,_), !ArmorSpellProfile(E,I,_,_).

// @rule validate.input.spell.loadout
Violation(E,F,"missing_armor_loadout") :- ArmorSpell(E,F,_,A,_,_), !ArmorLoadout(E,A,_,_,_,_).

// @rule validate.input.spell.overlap
Violation(E,A,"multiple_armor_spells") :- ArmorSpellActive(E,F,A,_), ArmorSpellActive(E,G,A,_), F != G.

// @rule validate.input.legacy.armor
Violation(E,A,"unresolved_2014_armor_training") :- ArmorLoadout(E,A,I,0,_,_), I != "unarmored".

// @rule validate.input.legacy.shield
Violation(E,A,"unresolved_2014_shield_training") :- ArmorLoadout(E,A,_,_,1,0).

// @rule validate.input.legacy.size
Violation(E,T,"missing_actor_size") :- WeaponUse(E,T,A,W,_,_,_,_,_), WeaponProfile(E,W,_,_,_,_,_,1,_,_), !ActorSize(E,A,_).

// @rule validate.input.revised.dismissal
Violation(E,F,"unsupported_spell_dismissal") :- ArmorSpell(E,F,_,_,_,1).

// @rule validate.input.armor.worn.dex
Violation(E,A,"missing_armor_ability") :- ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,C,_,_,_), C != "heavy", !AbilityScore(E,A,"dex",_).

// @rule validate.input.weapon.proficiency
Violation(E,A,"unsupported_weapon_proficiency") :- WeaponProficiency(E,A,W), !WeaponProfile(E,W,_,_,_,_,_,_,_,_).

// @rule validate.input.skill.proficiency
Violation(E,A,"unsupported_skill_proficiency") :- SkillProficiency(E,A,S,_), !SkillAbility(E,S,_).

// @rule validate.input.weapon.heavy.ability
Violation(E,T,"missing_heavy_ability") :- WeaponUse(E,T,A,W,_,_,_,_,_), WeaponProfile(E,W,"ranged",_,_,_,_,1,_,_), !AbilityScore(E,A,"dex",_).

// @rule armor.strength.not.required
ArmorSpeedPenalty(E,A,0) :- ArmorLoadout(E,A,I,_,_,_), ArmorProfile(E,I,_,_,0,_).

// @rule armor.strength.unarmored
ArmorSpeedPenalty(E,A,0) :- ArmorLoadout(E,A,"unarmored",_,_,_).
